{
  "manifest_version": 3,
  "name": "Scholar Lens · 学术全景",
  "version": "1.4.3",
  "minimum_chrome_version": "111",
  "description": "融合发表统计、作者高亮、CCF 2026 与内置中科院/JCR/IF 2025、新锐 2026 快照，统一筛选与导出。",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Scholar Lens",
    "default_popup": "src/popup.html"
  },
  "options_page": "src/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://scholar.google.com/*",
        "https://scholar.google.com.hk/*",
        "https://scholar.google.com.sg/*",
        "https://scholar.google.com.tw/*",
        "https://scholar.google.cn/*",
        "https://scholar.google.com.au/*",
        "https://scholar.google.co.uk/*",
        "https://scholar.google.co.jp/*",
        "https://scholar.google.co.in/*",
        "https://scholar.google.de/*",
        "https://scholar.google.fr/*",
        "https://scholar.google.ca/*",
        "https://scholar.google.com.br/*",
        "https://scholar.google.co.kr/*",
        "https://scholar.google.es/*",
        "https://scholar.google.it/*",
        "https://scholar.google.nl/*",
        "https://scholar.google.ch/*",
        "https://scholar.google.com.my/*",
        "https://scholar.google.com.vn/*",
        "https://scholar.google.co.id/*",
        "https://scholar.google.co.th/*",
        "https://scholar.google.com.tr/*",
        "https://scholar.google.co.nz/*",
        "https://scholar.google.co.za/*",
        "https://scholar.google.pl/*",
        "https://scholar.google.se/*",
        "https://scholar.google.com.mx/*"
      ],
      "js": [
        "src/venue-normalizer.js",
        "src/core.js",
        "src/catalog.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'"
  }
}
